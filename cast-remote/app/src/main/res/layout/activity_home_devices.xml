<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B14">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="48dp"
            android:paddingRight="16dp"
            android:paddingBottom="112dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROL HOME DEVICES"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:textColor="#E5E7EB" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Control your home devices. Devices are saved for your home and shown here with their type and power controls, even before a refresh. Tap Power off to turn a device off."
                android:textColor="#9CA3AF"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnHomeRefresh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#2E6BFF"
                    android:text="Refresh"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
                <Button
                    android:id="@+id/btnHomeCopyDiag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#23233A"
                    android:enabled="false"
                    android:text="Copy diagnostic"
                    android:textAllCaps="false"
                    android:textColor="#E5E7EB" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnHomeBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#23233A"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:textColor="#E5E7EB" />
                <Button
                    android:id="@+id/btnHomeLog"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#23233A"
                    android:text="Log"
                    android:textAllCaps="false"
                    android:textColor="#E5E7EB" />
            </LinearLayout>
            <Button
                android:id="@+id/btnHomeSendDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#2E6BFF"
                android:enabled="false"
                android:text="Send diagnostic"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/devicesNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="No saved devices yet - checking your home..."
                android:textColor="#9CA3AF"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.12"
                android:text="DEVICES"
                android:textColor="#7C7C9A"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/devicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.12"
                android:text="DIAGNOSTIC"
                android:textColor="#7C7C9A"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/homeOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="#E5E7EB"
                    android:textSize="13sp"
                    android:typeface="monospace" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:text="v2.7 (17)"
        android:textColor="#9CA3AF"
        android:textSize="12sp" />
</LinearLayout>
