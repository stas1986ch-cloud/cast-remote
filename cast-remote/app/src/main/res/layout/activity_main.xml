<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B14">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="48dp"
            android:paddingRight="16dp"
            android:paddingBottom="112dp">
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE SCREEN CONTROL AND CAST"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#E5E7EB" />
            <Button
                android:id="@+id/btnMirrorPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mirror what's playing"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tap Refresh casting devices to find TVs."
                android:textColor="#E5E7EB"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/linkInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#17172A"
                android:hint="Paste a link - YouTube, video, audio, image, web page, stream"
                android:padding="12dp"
                android:textColor="#E5E7EB"
                android:textColorHint="#8888AA" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:layout_marginEnd="8dp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="14sp"
                    android:text="Refresh casting devices"
                    android:textColor="#FFFFFF" />
                <Button
                    android:id="@+id/btnStopAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="Stop all"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
            <Button
                android:id="@+id/btnReceive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Receive on this phone"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnHomeDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Control home devices"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Log"
                android:textColor="#FFFFFF" />
            <Spinner
                android:id="@+id/targetSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#17172A"
                android:popupBackground="#17172A" />
            <Button
                android:id="@+id/btnPlayAny"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Play link"
                android:textColor="#FFFFFF" />
            <LinearLayout
                android:id="@+id/howItWorksBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#17172A"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How it works"
                    android:textColor="#E5E7EB"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="1. Cast to a TV - play a video on one TV first (from this app or the YouTube app)."
                    android:textColor="#9CA3AF"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="2. Select which one to mirror - pick the TV that is playing."
                    android:textColor="#9CA3AF"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="3. Select which one to play - pick the TV to play it on."
                    android:textColor="#9CA3AF"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/devicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:text="v2.7 (17)"
        android:textColor="#9CA3AF"
        android:textSize="12sp" />
</LinearLayout>
