<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Fixed Header pinned at top while content scrolls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0E17"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/sxc_logo"
            android:layout_width="148dp"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_sxc_automation_logo"
            android:contentDescription="SXC Automation Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.20"
            android:text="SXC AUTOMATION"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hub_title"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="GOOGLE SCREEN CONTROL &amp; CAST"
            android:textColor="#00FFFF"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="22sp"
            app:autoSizeMinTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <View
            android:layout_width="160dp"
            android:layout_height="2dp"
            android:layout_marginTop="6dp"
            android:background="#3300FFFF" />
    </LinearLayout>

    <!-- Scrollable centered Hub tiles -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <GridLayout
                android:id="@+id/hub_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:columnOrderPreserved="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tile_hdmi_settings"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_margin="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tile_selector"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:duplicateParentState="true"
                            android:src="@android:drawable/ic_menu_preferences"
                            app:tint="#00FFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:duplicateParentState="true"
                            android:gravity="center"
                            android:text="HDMI AUTO-BOOT"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tile_hdmi_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:duplicateParentState="true"
                            android:gravity="center"
                            android:text="Config &amp; Arm"
                            android:textColor="#8899A6"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tile_cast_remote"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_margin="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tile_selector"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:duplicateParentState="true"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="#EC4899" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:duplicateParentState="true"
                            android:gravity="center"
                            android:text="CAST DEVICE CONTROLS"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tile_cast_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:duplicateParentState="true"
                            android:gravity="center"
                            android:text="Pin, Mirror &amp; TV Power"
                            android:textColor="#00FFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tile_nest_monitor"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_margin="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tile_selector"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:duplicateParentState="true"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="#10B981" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:duplicateParentState="true"
                            android:gravity="center"
                            android:text="NEST MONITOR"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tile_nest_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:duplicateParentState="true"
                            android:gravity="center"
                            android:text="Temp Alerts &amp; Reset"
                            android:textColor="#10B981"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
