<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.SHUTDOWN" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@mipmap/ic_banner"
        android:label="AndroidTV &amp; Cast Utilities"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ProjectAutoSwitch">

        <!-- Google AdMob Application ID (Test ID: replace with your production ID before publishing) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name="com.project.autoswitch.ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ProjectAutoSwitch.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.project.autoswitch.ui.MainActivity"
            android:exported="false" />

        <activity
            android:name="com.project.autoswitch.ui.HdmiSettingsActivity"
            android:exported="false" />

        <activity
            android:name="com.project.autoswitch.ui.cast.CastRemoteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name="com.project.autoswitch.ui.AutoSwitchService"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.project.autoswitch.ui.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>